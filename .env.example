# atTrack environment — copy to .env.local and edit.
# Placeholders only. Never commit a real key; .gitignore excludes .env* except
# this file.

# ---------------------------------------------------------------------------
# Data location
# ---------------------------------------------------------------------------
# Where the SQLite database, uploads and logs live. Electron sets this to the
# folder the user picked during setup; unset means "<repo>/.data".
# SQLITE_DIR=
# STORAGE_DIR=

# ---------------------------------------------------------------------------
# Logging  (see docs/LOGGING.md)
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal.
# Default: debug in development, info in production.
# Note: db.query lines are debug, so `info` keeps normal query noise off while
# db.slow warnings still come through.
# ATTRACK_LOG_LEVEL=info

# Where NDJSON log files are written. Default "<SQLITE_DIR or repo>/.data/logs".
# ATTRACK_LOG_DIR=

# Log files older than this are deleted at boot. Default 7.
# ATTRACK_LOG_RETENTION_DAYS=7

# A database query slower than this many milliseconds is logged at warn as
# `db.slow`, regardless of log level. Default 50.
# ATTRACK_DB_SLOW_MS=50

# ---------------------------------------------------------------------------
# Log drain — OPT-IN, off by default
# ---------------------------------------------------------------------------
# With no URL set, the drain starts no timer, opens no file and makes no
# network call. The log file is your own job-search activity; shipping it
# anywhere is a deliberate choice. See docs/LOGGING.md for per-vendor setup.
# ATTRACK_LOG_DRAIN_URL=
# ATTRACK_LOG_DRAIN_TOKEN=

# "ndjson" (default) or "json-array", depending on what the endpoint accepts.
# ATTRACK_LOG_DRAIN_FORMAT=ndjson

# Flush after this many lines, or after this many ms, whichever comes first.
# ATTRACK_LOG_DRAIN_BATCH=100
# ATTRACK_LOG_DRAIN_INTERVAL_MS=5000

# JSON object of extra request headers, for endpoints that do not use a bearer
# token (Datadog wants DD-API-KEY, Splunk HEC wants "Authorization: Splunk …").
# ATTRACK_LOG_DRAIN_HEADERS={"DD-API-KEY":"your-key-here"}
