{
  "name": "betterjob",
  "version": "0.1.1",
  "description": "Personal career workspace for managing job applications, documents, interviews, and AI-assisted preparation.",
  "author": "BetterJob",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KamrulIslamArnob/atTrack-Playground.git"
  },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3788",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pdf-worker.js",
    "icons:build": "node scripts/generate-desktop-icons.js",
    "electron:dev": "node scripts/prepare-electron-build.js && electron electron/main.js",
    "electron:build:win": "node scripts/prepare-electron-build.js && node scripts/electron-build-retry.js --win --publish never",
    "electron:build:mac": "node scripts/prepare-electron-build.js && node scripts/electron-build-retry.js --mac --publish never",
    "electron:build:all": "node scripts/prepare-electron-build.js && node scripts/electron-build-retry.js --win --mac --publish never",
    "electron:release": "node scripts/prepare-electron-build.js && electron-builder --win --mac --publish always"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/google": "^4.0.43",
    "@ai-sdk/openai": "^4.0.41",
    "@assistant-ui/react": "^0.15.14",
    "@assistant-ui/react-markdown": "^0.14.10",
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.16.0",
    "ai": "^7.0.64",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "^4.0.379",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pino-pretty": "^13.1.3",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
