{
  "name": "atTrack",
  "version": "1.5.0",
  "description": "Personal career workspace for managing job applications, documents, interviews, and AI-assisted preparation.",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3308",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "icons:build": "node scripts/generate-desktop-icons.js",
    "electron:dev": "node scripts/prepare-electron-build.js && electron electron/main.js",
    "electron:build:win": "node scripts/prepare-electron-build.js && electron-builder --win --publish never",
    "electron:build:mac": "node scripts/prepare-electron-build.js && electron-builder --mac --publish never",
    "electron:build:all": "node scripts/prepare-electron-build.js && electron-builder --win --mac --publish never",
    "electron:release": "node scripts/prepare-electron-build.js && electron-builder --win --mac --publish always"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/google": "^4.0.43",
    "@ai-sdk/openai": "^4.0.41",
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.16.0",
    "ai": "^7.0.64",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "^4.0.379",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pino-pretty": "^13.1.3",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
